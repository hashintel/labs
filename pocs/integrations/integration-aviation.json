{
  "id": "flightaware",
  "mode": "rest-api",
  "auth": { "type": "header", "name": "x-apikey", "value": "${AERO_API_KEY}" },
  "rateLimitMs": 1000,
  "endpoints": {
    "arrivals": {
      "url": "https://aeroapi.flightaware.com/aeroapi/airports/EGLL/flights/scheduled_arrivals",
      "primaryKey": "fa_flight_id",
      "pagination": { "type": "next-link", "field": "links.next" },
      "resultsField": "scheduled_arrivals"
    }
  }
}
