{
  "extends": "../tsconfig.json",
  "compilerOptions": { "rootDir": ".", "lib": ["ES2023"], "types": [], "jsx": "preserve" },
  "include": ["."],
  // The boundary test lists this folder through Vite's import.meta.glob, and the scripts run
